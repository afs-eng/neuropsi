# ============================================================
# NeuroAvalia — DigitalOcean (Droplet + Managed PostgreSQL)
# ============================================================

# Dominio e HTTPS
APP_DOMAIN=sistema.seudominio.com.br
ACME_EMAIL=infra@seudominio.com.br

# Django
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=<gere-com-openssl-rand-hex-64>
ALLOWED_HOSTS=sistema.seudominio.com.br
CSRF_TRUSTED_ORIGINS=https://sistema.seudominio.com.br
CORS_ALLOWED_ORIGINS=https://sistema.seudominio.com.br
FRONTEND_BASE_URL=https://sistema.seudominio.com.br
BACKEND_PUBLIC_URL=https://sistema.seudominio.com.br
DATABASE_URL=postgresql://doadmin:senha@db-postgresql-nyc3-12345-do-user-1234567-0.l.db.ondigitalocean.com:25060/defaultdb?sslmode=require
DATABASE_SSL_REQUIRE=True

# Frontend / proxy interno
INTERNAL_API_BASE_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=

# Cache (opcional: use Managed Redis se quiser cache compartilhado)
# REDIS_URL=redis://default:senha@redis-do-user-1234567-0.l.db.ondigitalocean.com:25061/0

# IA (OpenRouter via API OpenAI-compatible)
AI_PROVIDER=openai
OPENAI_API_KEY=<sua-chave-openrouter>
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_REFERER=https://sistema.seudominio.com.br
OPENAI_TITLE=NeuroAvalia
OPENAI_MODEL_TEXT=google/gemma-4-31b-it:free
OPENAI_MODEL_REASONING=google/gemma-4-31b-it:free
OPENAI_FALLBACK_MODELS=google/gemma-3-27b-it:free,meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-20b:free

# E-mail
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=NeuroAvalia <noreply@seudominio.com.br>

# WhatsApp (Evolution API — opcional)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
