# Copie para .env.specialists.local (ignorado pelo Git). Não coloque credenciais neste exemplo.
# Ativação deliberada: preencher modelo, chave e banco antes de mudar false para true.
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_LOCAL_ALEATORIA
SPECIALIST_AI_ENABLED=false
SPECIALIST_AI_INSTRUMENTS=wisc4,wais3,wasi,bpa2,ravlt,fdt,etdah_pais,scared,srs2
SPECIALIST_AI_MODEL=
AI_PROVIDER=openai
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
# O worker precisa do MESMO banco do backend que enfileirou o piloto.
# Para acessar o banco do Render no computador, use a URL EXTERNA e SSL.
DATABASE_URL=
DATABASE_SSL_REQUIRE=true
