# Copie para .env.specialists.local (ignorado pelo Git). Não contém credenciais reais.
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_LOCAL_ALEATORIA
# Habilite somente após configurar o banco compartilhado e escolher aplicações sintéticas.
SPECIALIST_AI_ENABLED=false
SPECIALIST_AI_PROVIDER=ollama
SPECIALIST_AI_MODEL=qwen3:8b
SPECIALIST_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
SPECIALIST_AI_INSTRUMENTS=wisc4
# Não altere AI_PROVIDER/OPENAI_* do backend para ativar apenas os especialistas.
# Preencha a URL externa do MESMO banco PostgreSQL do backend, nunca a publique.
DATABASE_URL=
DATABASE_SSL_REQUIRE=true
